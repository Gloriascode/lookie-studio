{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lookie-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/files/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lookie-studio",
      "database_id": "22347f30-5790-4782-9cbc-93a1f2ffa6ca",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lookie-studio" }],
  "vars": {
    "ARCADE_API_BASE": "https://platform.arcade.ai/v1",
    "ARCADE_USER_AGENT": "lookie-studio/0.1"
  },
  "observability": { "enabled": true }
}
